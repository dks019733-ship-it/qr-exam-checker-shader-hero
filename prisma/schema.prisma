generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  defaultLearningArea String @default("")
  schoolKey     String    @default(cuid())
  accounts      Account[]
  sessions      Session[]
  classes       Class[]
  subjects      Subject[]
  teachingAssignments TeachingAssignment[]
  exams         Exam[]
  driveFolders  DriveFolder[]
  answerSheetTemplate AnswerSheetTemplate?
  aiChatSessions AiChatSession[]
  aiChatMemory  TeacherAiMemory?
  generatedMaterials GeneratedMaterial[]
  googleForms   GoogleForm[]
  gradeColumns  GradeColumn[]
  assignments   Assignment[]
  attendanceSessions AttendanceSession[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId              String
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String? @db.Text
  access_token        String? @db.Text
  expires_at           Int?
  token_type           String?
  scope                String?
  id_token             String? @db.Text
  session_state        String?
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Class {
  id        String    @id @default(cuid())
  name      String
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  students  Student[]
  exams     Exam[]
  gradeColumns GradeColumn[]
  teachingAssignments TeachingAssignment[]
  assignments Assignment[]
  attendanceSessions AttendanceSession[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([ownerId])
}

model Student {
  id        String   @id @default(cuid())
  rollNo    String   @default("")
  studentNo String
  name      String
  isActive  Boolean  @default(true)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  attempts  ExamAttempt[]
  gradeScores GradeScore[]
  formResponseReviews FormResponseReview[]
  identityId String?
  identity StudentIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  courseEnrollments CourseEnrollment[]
  attendanceRecords AttendanceRecord[]
  submissions Submission[]
  qrToken   String   @unique @default(cuid())
  createdAt DateTime @default(now())
  @@unique([classId, studentNo])
  @@index([classId, rollNo])
  @@index([identityId])
}

model Exam {
  id          String       @id @default(cuid())
  title       String
  subject     String       @default("")
  ownerId     String
  classId     String?
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  questions   Question[]
  attempts    ExamAttempt[]
  driveFiles  DriveFile[]
  gradeColumn GradeColumn?
  teachingAssignmentId String?
  teachingAssignment TeachingAssignment? @relation(fields: [teachingAssignmentId], references: [id], onDelete: SetNull)
  status      ExamStatus   @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([ownerId])
  @@index([teachingAssignmentId])
}

model Subject {
  id        String   @id @default(cuid())
  ownerId   String
  code      String
  name      String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, code])
  @@index([ownerId, name])
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  ownerId   String
  subjectId String
  classId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroom Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments CourseEnrollment[]
  exams     Exam[]
  gradeColumns GradeColumn[]
  assignments Assignment[]
  attendanceSessions AttendanceSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([subjectId, classId])
  @@index([ownerId, classId])
  @@index([ownerId, subjectId])
}

model CourseEnrollment {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  assignment   TeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model StudentIdentity {
  id        String   @id @default(cuid())
  schoolKey String
  className String
  studentNo String
  name      String
  pinHash   String?  @db.Text
  students  Student[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolKey, className, studentNo])
  @@index([schoolKey, studentNo])
}

model Question {
  id          String @id @default(cuid())
  examId      String
  number      Int
  answer      String
  exam        Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  @@unique([examId, number])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  studentId   String
  answersJson Json
  score       Float?
  status      AttemptStatus @default(PENDING_REVIEW)
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model DriveFolder {
  id        String @id @default(cuid())
  ownerId   String
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId  String
  name      String
  createdAt DateTime @default(now())
  @@index([ownerId])
}

model DriveFile {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  driveFileId String
  kind       String
  name       String
  createdAt  DateTime @default(now())
  @@index([examId])
}

enum ExamStatus {
  DRAFT
  READY
  CHECKING
  REVIEW
  CONFIRMED
  ARCHIVED
}

enum AttemptStatus {
  PENDING_REVIEW
  READY_TO_CONFIRM
  CONFIRMED
}


model AnswerSheetTemplate {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  schoolName      String   @default("โรงเรียนตัวอย่างวิทยา")
  logoDataUrl     String?  @db.Text
  examTitle       String   @default("แบบทดสอบวัดผลสัมฤทธิ์ทางการเรียน")
  subject         String   @default("")
  questionCount   Int      @default(40)
  classLabel      String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiChatSession {
  id        String          @id @default(cuid())
  ownerId   String
  title     String          @default("สนทนาใหม่")
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  @@index([ownerId, updatedAt])
}

model TeacherAiMemory {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  preferences String   @default("[]") @db.Text
  enabled     Boolean  @default(true)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      AIChatRole
  content   String      @db.Text
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  @@index([sessionId, createdAt])
}

model GeneratedMaterial {
  id                 String                @id @default(cuid())
  ownerId            String
  kind               GeneratedMaterialKind
  title              String
  subject            String
  gradeLevel         String
  topic              String
  learningObjectives String                @default("") @db.Text
  documentType       String?
  content            Json
  status             GeneratedMaterialStatus @default(pending_review)
  reviewNotes        String                @default("") @db.Text
  reviewedAt         DateTime?
  owner              User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  googleForm         GoogleForm?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  @@index([ownerId, updatedAt])
}

model GoogleForm {
  id            String           @id @default(cuid())
  ownerId       String
  materialId    String           @unique
  formId        String           @unique
  editUrl       String           @db.Text
  responderUrl  String           @db.Text
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  material      GeneratedMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  gradeColumn   GradeColumn?
  createdAt     DateTime         @default(now())
  @@index([ownerId])
}

enum GradePeriod {
  // Retained for database compatibility; the gradebook only exposes the two SGS periods below.
  BEFORE_MIDTERM
  MIDTERM
  AFTER_MIDTERM
}

model GradeColumn {
  id           String       @id @default(cuid())
  ownerId      String
  classId      String
  title        String
  period       GradePeriod
  maxScore     Float        @default(10)
  examId       String?      @unique
  googleFormId String?      @unique
  assignmentId String?      @unique
  sourceColumnId String?
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  classroom    Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  exam         Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  googleForm   GoogleForm?  @relation(fields: [googleFormId], references: [id], onDelete: SetNull)
  assignment   Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  teachingAssignmentId String?
  teachingAssignment TeachingAssignment? @relation(fields: [teachingAssignmentId], references: [id], onDelete: SetNull)
  sourceColumn GradeColumn? @relation("GradeColumnDestinations", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  destinationColumns GradeColumn[] @relation("GradeColumnDestinations")
  scores       GradeScore[]
  pendingFormScores PendingFormScore[]
  formResponseReviews FormResponseReview[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@index([ownerId, classId, period])
  @@index([teachingAssignmentId])
  @@unique([sourceColumnId, classId])
}

model GradeScore {
  id             String      @id @default(cuid())
  columnId       String
  studentId      String
  score          Float?
  manualOverride Boolean     @default(false)
  column         GradeColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedAt DateTime    @updatedAt
  @@unique([columnId, studentId])
  @@index([studentId])
}

model PendingFormScore {
  id          String      @id @default(cuid())
  columnId    String
  responseId  String
  rollNo      String      @default("")
  studentName String
  room        String      @default("")
  manualReviewRequired Boolean @default(false)
  score       Float
  submittedAt DateTime?
  column      GradeColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@unique([columnId, responseId])
  @@index([columnId])
}

model FormResponseReview {
  id            String      @id @default(cuid())
  columnId      String
  responseId    String
  studentId     String?
  score         Float
  questionScores Json
  column        GradeColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  student       Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@unique([columnId, responseId])
  @@index([columnId])
  @@index([studentId])
}

enum AIChatRole {
  user
  assistant
}

enum GeneratedMaterialKind {
  exam
  document
}

enum GeneratedMaterialStatus {
  pending_review
  approved
}

enum SystemIncidentSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum SystemIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model SystemIncident {
  id          String                 @id @default(cuid())
  fingerprint String                 @unique
  source      String
  severity    SystemIncidentSeverity
  status      SystemIncidentStatus   @default(OPEN)
  title       String
  summary     String                 @db.Text
  route       String?
  httpStatus  Int?
  occurrenceCount Int                @default(1)
  firstSeenAt DateTime               @default(now())
  lastSeenAt  DateTime               @default(now())
  resolvedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  @@index([status, severity, lastSeenAt])
  @@index([source, lastSeenAt])
}

model SystemGuardianAuditLog {
  id          String   @id @default(cuid())
  actorEmail  String
  action      String
  targetType  String?
  targetId    String?
  outcome     String
  details     Json?
  createdAt   DateTime @default(now())
  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
}

model LineWebhookEvent {
  id              String   @id @default(cuid())
  webhookEventId  String   @unique
  sourceUserId    String?
  eventType       String
  processedAt     DateTime @default(now())
  @@index([processedAt])
}

enum SystemGuardianTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SystemGuardianTaskType {
  SYSTEM_HEALTH_CHECK
}

model SystemGuardianTask {
  id               String                   @id @default(cuid())
  type             SystemGuardianTaskType
  status           SystemGuardianTaskStatus  @default(QUEUED)
  requestedBy      String
  source           String                   @default("WEB")
  notifyLineUserId String?
  currentStep      String?
  progressPercent  Int                      @default(0)
  resultSummary    String?                  @db.Text
  failureCode      String?
  attempts         Int                      @default(0)
  maxAttempts      Int                      @default(2)
  retryOfId        String?                  @unique
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  events           SystemGuardianTaskEvent[]
  retryOf          SystemGuardianTask?      @relation("SystemGuardianTaskRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries           SystemGuardianTask[]     @relation("SystemGuardianTaskRetries")
  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
}

model SystemGuardianTaskEvent {
  id              String                   @id @default(cuid())
  taskId          String
  status          SystemGuardianTaskStatus
  step            String
  message         String                   @db.Text
  progressPercent Int?
  createdAt       DateTime                 @default(now())
  task            SystemGuardianTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, createdAt])
}

model SiteAnnouncement {
  id               String   @id @default("global")
  message          String   @db.VarChar(240)
  active           Boolean  @default(true)
  source           String   @default("DEFAULT")
  deploymentId     String?
  deploymentStatus String?
  deploymentUrl    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

enum AssignmentMode {
  TEACHER_CHECK
  SYSTEM_UPLOAD
  GOOGLE_FORM
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  RETURNED
}

model AttendanceSession {
  id                   String   @id @default(cuid())
  ownerId              String
  classId              String
  teachingAssignmentId String
  date                 DateTime @db.Date
  topic                String   @default("")
  owner                User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  classroom            Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  records              AttendanceRecord[]
  assignments          Assignment[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@unique([teachingAssignmentId, date])
  @@index([ownerId, classId, date])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  note      String           @default("")
  markedAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([sessionId, studentId])
  @@index([studentId, updatedAt])
}

model Assignment {
  id                   String           @id @default(cuid())
  ownerId              String
  classId              String
  teachingAssignmentId String
  attendanceSessionId  String?
  groupId              String?
  title                String
  description          String           @default("") @db.Text
  mode                 AssignmentMode
  status               AssignmentStatus @default(DRAFT)
  googleFormUrl        String?          @db.Text
  dueAt                DateTime?
  maxScore             Float?
  autoMarkAttendance   Boolean          @default(false)
  owner                User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  classroom            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  attendanceSession    AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  files                AssignmentFile[]
  submissions          Submission[]
  gradeColumn           GradeColumn?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  @@index([ownerId, classId, status, dueAt])
  @@index([teachingAssignmentId, createdAt])
  @@unique([groupId, classId])
}

model AssignmentFile {
  id           String     @id @default(cuid())
  assignmentId String
  objectKey    String     @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  @@index([assignmentId])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  score        Float?
  feedback     String           @default("") @db.Text
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files        SubmissionFile[]
  reviewedAt   DateTime?
  updatedAt    DateTime         @updatedAt
  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
  @@index([assignmentId, status])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  objectKey    String     @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  @@index([submissionId])
}


enum FeatureAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

model FeatureAvailability {
  id        String                   @id @default(cuid())
  key       String                   @unique
  status    FeatureAvailabilityStatus @default(AVAILABLE)
  reason    String                   @default("") @db.VarChar(240)
  untilAt   DateTime?
  updatedBy String                   @default("SYSTEM")
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  @@index([status, untilAt])
}
