# Local / production database
# Local PostgreSQL development database. For Supabase, use the Transaction Pooler
# URL (port 6543, with pgbouncer=true) here and the Session Pooler URL (port 5432)
# as DIRECT_URL. Prisma CLI uses DIRECT_URL for schema changes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_exam_checker?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/qr_exam_checker?schema=public"

# NextAuth/Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Public URL used by the deployed app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App-created Google Drive folder name
GOOGLE_DRIVE_APP_FOLDER_NAME="QR Exam Checker"

# Server-only Gemini API. Do not prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"


# System Guardian (server-only)
SYSTEM_OWNER_EMAIL="owner@example.com"
CRON_SECRET="replace-with-a-long-random-secret"

# LINE Messaging API (set after creating a LINE Official Account)
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
LINE_OWNER_USER_ID=""

# Supabase Storage (server-only; never prefix these with NEXT_PUBLIC_)
# Create a private bucket named assignment-files in the existing Supabase project.
SUPABASE_URL="https://ihdlafuxdhynxrhlxplg.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="assignment-files"
UPLOAD_MAX_BYTES="20971520"
